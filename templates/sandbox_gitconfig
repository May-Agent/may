[user]
{% if let Some(identity) = identity %}	name = {{ identity.name|git_quoted }}
	email = {{ identity.email|git_quoted }}
{% endif %}{% if let Some(signing) = signing %}	signingkey = {{ signing.key|git_quoted }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ signing.program|git_quoted }}
[commit]
	gpgsign = true
{% endif %}